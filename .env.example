# Copie para `.env` na raiz. Todas as chaves são opcionais.

# Sem WHATSAPP_TOKEN o servidor usa o Stub: nada sai para a Meta e o envio
# devolve um id falso. Com o token, chama a Cloud API de verdade.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Assinatura HMAC do webhook e token do handshake de verificação da Meta.
# Os padrões abaixo valem só para desenvolvimento local.
# WHATSAPP_APP_SECRET=dev-app-secret
# WHATSAPP_VERIFY_TOKEN=dev-verify-token

# Sem DATABASE_URL o banco é o pglite embutido em ./pgdata (nada a instalar).
# DATABASE_URL=postgres://user:pass@localhost:5432/crm_chat

# PORT=3000
